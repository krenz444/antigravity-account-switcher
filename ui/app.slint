// Antigravity Switchboard - Main Application Window
// Native Rust + Slint Desktop Switchboard
// Vertical List Layout (Growing Down)

import { Theme } from "./theme.slint";
import { ProgressBar } from "./progress_bar.slint";
import { AccountCard, AccountData } from "./account_card.slint";
import { HeroBar, ClaudeCard, DeepSeekCard } from "./provider_cards.slint";
import { ScrollView } from "std-widgets.slint";

export { AccountData }

export component AppWindow inherits Window {
    title: "Antigravity Switchboard";
    icon: @image-url("../app_icon.png");
    preferred-width: 640px;
    preferred-height: 600px;
    min-width: 540px;
    min-height: 480px;
    background: Theme.bg-app;

    // Antigravity Accounts Data Model
    in property <[AccountData]> accounts: [
        {
            id: "acc_1",
            alias: "dev.primary@gmail.com",
            email: "dev.primary@gmail.com",
            tier: "Pro",
            is_live: true,
            is_selected: true,
            session_quota_pct: 85.0,
            session_quota_label: "85%",
            weekly_quota_pct: 64.0,
            weekly_quota_label: "64%",
            reset_countdown: "2h 15m",
            weekly_reset_text: "Resets Mon 7:00 PM",
            status_text: "Active",
        },
        {
            id: "acc_2",
            alias: "work.account@company.com",
            email: "work.account@company.com",
            tier: "Pro",
            is_live: false,
            is_selected: false,
            session_quota_pct: 42.0,
            session_quota_label: "42%",
            weekly_quota_pct: 28.0,
            weekly_quota_label: "28%",
            reset_countdown: "4h 50m",
            weekly_reset_text: "Resets Mon 7:00 PM",
            status_text: "Standby",
        },
        {
            id: "acc_3",
            alias: "spare.account@gmail.com",
            email: "spare.account@gmail.com",
            tier: "Free",
            is_live: false,
            is_selected: false,
            session_quota_pct: 100.0,
            session_quota_label: "100%",
            weekly_quota_pct: 100.0,
            weekly_quota_label: "100%",
            reset_countdown: "Full Quota",
            weekly_reset_text: "Resets Mon 7:00 PM",
            status_text: "Standby",
        },
        {
            id: "acc_4",
            alias: "lab.account@gmail.com",
            email: "lab.account@gmail.com",
            tier: "Pro",
            is_live: false,
            is_selected: false,
            session_quota_pct: 100.0,
            session_quota_label: "100%",
            weekly_quota_pct: 100.0,
            weekly_quota_label: "100%",
            reset_countdown: "Full Quota",
            weekly_reset_text: "Resets Mon 7:00 PM",
            status_text: "Standby",
        }
    ];

    // Hero bar properties
    in property <string> active_alias: "dev.primary@gmail.com";
    in property <string> active_email: "dev.primary@gmail.com";
    in property <string> client_status: "Client Running";
    in property <bool> client_connected: true;

    // Claude Code status properties
    in property <string> claude_email: "dropshipmk4@gmail.com";
    in property <string> claude_tier: "Claude Pro";
    in property <float> claude_session_pct: 100.0;
    in property <string> claude_session_label: "100%";
    in property <float> claude_weekly_pct: 72.0;
    in property <string> claude_weekly_label: "72%";
    in property <string> claude_reset: "Ready";
    in property <string> claude_tokens: "";
    in property <bool> claude_connected: true;

    // DeepSeek status properties
    in property <string> deepseek_balance: "$10.50 USD";
    in property <string> deepseek_status: "Online / Ready";
    in property <string> deepseek_tier: "Pay-as-you-go";
    in property <string> deepseek_usage: "Month: $3.40";
    in property <bool> deepseek_connected: true;

    // System status
    in property <string> app_status: "Ready";
    in property <bool> is_refreshing: false;

    // Callbacks
    callback switch_account(string);
    callback select_account(string);
    callback refresh_clicked();
    callback relaunch_client_clicked();
    callback claude_action_clicked();
    callback deepseek_action_clicked();

    VerticalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-sm;

        // 1. Executive Top Header Bar
        HorizontalLayout {
            alignment: space-between;

            // Brand & Title
            HorizontalLayout {
                spacing: Theme.spacing-sm;

                Image {
                    source: @image-url("../app_icon.png");
                    width: 20px;
                    height: 20px;
                }

                Text {
                    text: "Antigravity Switchboard";
                    color: Theme.text-primary;
                    font-size: Theme.font-md;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                // Global hotkey badge
                Rectangle {
                    background: Theme.bg-badge;
                    border-width: 1px;
                    border-color: Theme.border-default;
                    border-radius: Theme.radius-xs;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 1px;
                        padding-bottom: 1px;
                        alignment: center;

                        Text {
                            text: "Ctrl+Alt+S";
                            color: Theme.accent-sky;
                            font-size: Theme.font-xs;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Status Pill & Refresh Button
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                alignment: end;

                // Live system indicator
                Rectangle {
                    background: Theme.bg-card;
                    border-width: 1px;
                    border-color: Theme.border-default;
                    border-radius: Theme.radius-pill;

                    HorizontalLayout {
                        padding-left: Theme.spacing-sm;
                        padding-right: Theme.spacing-sm;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        spacing: 5px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 5px;
                                height: 5px;
                                border-radius: 2.5px;
                                background: Theme.accent-emerald;
                            }
                        }

                        Text {
                            text: root.app_status;
                            color: Theme.text-secondary;
                            font-size: Theme.font-xs;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                // Refresh Button
                Rectangle {
                    width: 76px;
                    height: 24px;
                    border-radius: Theme.radius-sm;
                    background: refresh_touch.has-hover ? Theme.bg-button-hover : Theme.bg-button;
                    border-width: 1px;
                    border-color: refresh_touch.has-hover ? Theme.border-hover : Theme.border-default;

                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    HorizontalLayout {
                        alignment: center;

                        Text {
                            text: root.is_refreshing ? "..." : "Refresh";
                            color: refresh_touch.has-hover ? Theme.accent-sky : Theme.text-primary;
                            font-size: Theme.font-xs;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    refresh_touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.refresh_clicked();
                        }
                    }
                }
            }
        }

        // 2. Active Client Hero Bar
        HeroBar {
            active_alias: root.active_alias;
            active_email: root.active_email;
            client_status: root.client_status;
            is_connected: root.client_connected;
            relaunch_clicked => {
                root.relaunch_client_clicked();
            }
        }

        // 3. Scrollable List Area (Growing Down)
        ScrollView {
            VerticalLayout {
                spacing: Theme.spacing-md;
                padding-right: 4px;

                // Antigravity Accounts Section
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "ANTIGRAVITY ACCOUNTS";
                            color: Theme.text-secondary;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                        }

                        Text {
                            text: "Instant 1-click credential swap";
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                        }
                    }

                    // Vertical list of accounts growing down
                    VerticalLayout {
                        spacing: 6px;

                        for account in root.accounts : AccountCard {
                            account_id: account.id;
                            alias: account.alias;
                            email: account.email;
                            tier: account.tier;
                            is_live: account.is_live;
                            is_selected: account.is_selected;
                            session_quota_pct: account.session_quota_pct;
                            session_quota_label: account.session_quota_label;
                            weekly_quota_pct: account.weekly_quota_pct;
                            weekly_quota_label: account.weekly_quota_label;
                            reset_countdown: account.reset_countdown;
                            weekly_reset_text: account.weekly_reset_text;
                            status_text: account.status_text;

                            switch_clicked => {
                                root.switch_account(account.id);
                            }
                            card_selected => {
                                root.select_account(account.id);
                            }
                        }
                    }
                }

                // External Providers Section: Claude & DeepSeek
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "EXTERNAL AI TELEMETRY";
                            color: Theme.text-secondary;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                        }

                        Text {
                            text: "Claude Code CLI & DeepSeek Platform";
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                        }
                    }

                    // Vertical list of external providers growing down
                    VerticalLayout {
                        spacing: 6px;

                        ClaudeCard {
                            email: root.claude_email;
                            tier: root.claude_tier;
                            session_pct: root.claude_session_pct;
                            session_label: root.claude_session_label;
                            weekly_pct: root.claude_weekly_pct;
                            weekly_label: root.claude_weekly_label;
                            reset_countdown: root.claude_reset;
                            token_usage_text: root.claude_tokens;
                            is_connected: root.claude_connected;
                            action_clicked => {
                                root.claude_action_clicked();
                            }
                        }

                        DeepSeekCard {
                            balance_text: root.deepseek_balance;
                            status_text: root.deepseek_status;
                            tier_text: root.deepseek_tier;
                            monthly_usage_text: root.deepseek_usage;
                            is_connected: root.deepseek_connected;
                            top_up_clicked => {
                                root.deepseek_action_clicked();
                            }
                        }
                    }
                }
            }
        }
    }
}
