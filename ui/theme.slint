// Antigravity Switchboard - Theme & Design Tokens
// Executive Dark Palette matching Scout 1 specifications

export global Theme {
    // Backgrounds
    in property <color> bg-app: #080c14;
    in property <color> bg-card: #0f1728;
    in property <color> bg-card-selected: #121c32;
    in property <color> bg-card-hover: #162238;
    in property <color> bg-track: #172033;
    in property <color> bg-button: #1b2438;
    in property <color> bg-button-hover: #26334d;
    in property <color> bg-badge: #162136;
    in property <color> bg-hero: #0c1424;

    // Borders
    in property <color> border-default: #1d283a;
    in property <color> border-hover: #334155;
    in property <color> border-selected: #38bdf8;
    in property <color> border-active: #10b981;
    in property <color> border-subtle: #141c2c;

    // Text Colors
    in property <color> text-primary: #f8fafc;
    in property <color> text-secondary: #94a3b8;
    in property <color> text-muted: #788ea6; // Adjusted for >= 4.5:1 WCAG AA compliance against #0f1728

    // Accents
    in property <color> accent-sky: #38bdf8;
    in property <color> accent-emerald: #10b981;
    in property <color> accent-amber: #f59e0b;
    in property <color> accent-rose: #f43f5e;
    in property <color> accent-purple: #c084fc;
    in property <color> accent-blue: #60a5fa; // Adjusted for >= 4.5:1 WCAG AA compliance against #172554 & #1b2438

    // Spacing Tokens
    in property <length> spacing-xs: 4px;
    in property <length> spacing-sm: 8px;
    in property <length> spacing-md: 12px;
    in property <length> spacing-lg: 16px;
    in property <length> spacing-xl: 20px;
    in property <length> spacing-2xl: 24px;

    // Radius Tokens
    in property <length> radius-xs: 4px;
    in property <length> radius-sm: 6px;
    in property <length> radius-md: 8px;
    in property <length> radius-lg: 12px;
    in property <length> radius-pill: 9999px;

    // Typography Tokens
    in property <length> font-xs: 11px;
    in property <length> font-sm: 12px;
    in property <length> font-base: 13px;
    in property <length> font-md: 14px;
    in property <length> font-lg: 16px;
    in property <length> font-xl: 18px;
    in property <length> font-2xl: 22px;
}
