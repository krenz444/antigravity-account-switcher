// Antigravity Switchboard - Account Card Component
// High-density horizontal row card for vertical list layout
// Displays Antigravity Google Account identity, switch action, session & weekly quotas

import { Theme } from "./theme.slint";
import { ProgressBar } from "./progress_bar.slint";

export struct AccountData {
    id: string,
    alias: string,
    email: string,
    tier: string,
    is_live: bool,
    is_selected: bool,
    session_quota_pct: float,
    session_quota_label: string,
    weekly_quota_pct: float,
    weekly_quota_label: string,
    reset_countdown: string,
    weekly_reset_text: string,
    status_text: string,
}

export component AccountCard inherits Rectangle {
    in property <string> account_id: "";
    in property <string> alias: "Google Account";
    in property <string> email: "user@example.com";
    in property <string> tier: "Pro";
    in property <bool> is_live: false;
    in property <bool> is_selected: false;
    in property <float> session_quota_pct: 85.0;
    in property <string> session_quota_label: "85%";
    in property <float> weekly_quota_pct: 64.0;
    in property <string> weekly_quota_label: "64%";
    in property <string> reset_countdown: "Full Quota";
    in property <string> weekly_reset_text: "Resets Mon 7:00 PM";
    in property <string> status_text: "Standby";

    callback switch_clicked();
    callback card_selected();

    background: root.is_selected ? Theme.bg-card-selected :
                card_touch.has-hover ? Theme.bg-card-hover : Theme.bg-card;
    border-width: (root.is_live || root.is_selected) ? 1.5px : 1px;
    border-color: root.is_live ? Theme.border-active :
                  root.is_selected ? Theme.border-selected :
                  card_touch.has-hover ? Theme.border-hover : Theme.border-default;
    border-radius: Theme.radius-md;
    clip: true;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    card_touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.card_selected();
        }
    }

    // Left accent strip for live active account
    if root.is_live : Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: parent.height;
        background: Theme.accent-emerald;
    }

    VerticalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 5px;

        // Top line: Identity & Switch Button
        HorizontalLayout {
            alignment: space-between;

            // Identity Cluster
            HorizontalLayout {
                spacing: 7px;

                // Live status dot
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: root.is_live ? Theme.accent-emerald : #475569;
                    }
                }

                Text {
                    text: root.alias;
                    color: Theme.text-primary;
                    font-size: Theme.font-sm;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.email;
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // Tier badge
                Rectangle {
                    background: Theme.bg-badge;
                    border-width: 1px;
                    border-color: root.tier == "Pro" ? Theme.accent-sky : Theme.border-default;
                    border-radius: Theme.radius-xs;

                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        padding-top: 1px;
                        padding-bottom: 1px;
                        alignment: center;

                        Text {
                            text: root.tier;
                            color: root.tier == "Pro" ? Theme.accent-sky : Theme.text-secondary;
                            font-size: Theme.font-xs;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                // LIVE Pill
                if root.is_live : Rectangle {
                    background: #064e3b;
                    border-width: 1px;
                    border-color: Theme.accent-emerald;
                    border-radius: Theme.radius-xs;

                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        padding-top: 1px;
                        padding-bottom: 1px;
                        alignment: center;

                        Text {
                            text: "LIVE";
                            color: #6ee7b7;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Switch Action Button
            Rectangle {
                width: 80px;
                height: 22px;
                border-radius: Theme.radius-sm;
                background: root.is_live ? #064e3b :
                            btn_touch.has-hover ? Theme.bg-button-hover : Theme.bg-button;
                border-width: 1px;
                border-color: root.is_live ? Theme.accent-emerald :
                              btn_touch.has-hover ? Theme.border-hover : Theme.border-default;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                HorizontalLayout {
                    alignment: center;

                    Text {
                        text: root.is_live ? "ACTIVE" : "SWITCH";
                        color: root.is_live ? #6ee7b7 :
                               btn_touch.has-hover ? Theme.accent-sky : Theme.text-primary;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                btn_touch := TouchArea {
                    mouse-cursor: root.is_live ? MouseCursor.default : MouseCursor.pointer;
                    clicked => {
                        if !root.is_live {
                            root.switch_clicked();
                        }
                    }
                }
            }
        }

        // Bottom line: Dual Limit Meters side-by-side
        HorizontalLayout {
            spacing: Theme.spacing-md;

            // Meter 1: 5-Hour Session Quota
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "5h Limit";
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        font-weight: 500;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;

                        Text {
                            text: (root.reset_countdown == "Ready" || root.reset_countdown == "Full Quota") ? "Full Quota" : "Reset: " + root.reset_countdown;
                            color: (root.reset_countdown == "Ready" || root.reset_countdown == "Full Quota") ? Theme.accent-emerald : Theme.accent-sky;
                            font-size: Theme.font-xs;
                            font-weight: (root.reset_countdown == "Ready" || root.reset_countdown == "Full Quota") ? 600 : 400;
                            overflow: elide;
                        }

                        Text {
                            text: root.session_quota_label;
                            color: Theme.text-primary;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                        }
                    }
                }

                ProgressBar {
                    progress: root.session_quota_pct;
                }
            }

            // Meter 2: Weekly Quota
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Weekly";
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        font-weight: 500;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;

                        Text {
                            text: root.weekly_reset_text;
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            overflow: elide;
                        }

                        Text {
                            text: root.weekly_quota_label;
                            color: Theme.text-primary;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                        }
                    }
                }

                ProgressBar {
                    progress: root.weekly_quota_pct;
                }
            }
        }
    }
}
