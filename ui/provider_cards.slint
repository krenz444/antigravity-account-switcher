// Antigravity Switchboard - Provider Cards & Hero Bar
// ClaudeCard, DeepSeekCard, and Antigravity Client HeroBar
// Formatted as sleek horizontal row cards for vertical list layout

import { Theme } from "./theme.slint";
import { ProgressBar } from "./progress_bar.slint";

// Hero Bar: Sleek, compact top banner displaying active Antigravity Client credentials and Relaunch trigger
export component HeroBar inherits Rectangle {
    in property <string> active_alias: "Primary Google";
    in property <string> active_email: "dev.primary@gmail.com";
    in property <string> client_status: "Client Running";
    in property <bool> is_connected: true;

    callback relaunch_clicked();

    height: 38px;
    background: Theme.bg-hero;
    border-width: 1px;
    border-color: Theme.border-default;
    border-radius: Theme.radius-md;
    clip: true;

    // Left accent strip (Emerald)
    Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: parent.height;
        background: Theme.accent-emerald;
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        padding-top: 4px;
        padding-bottom: 4px;
        alignment: space-between;

        // Active Client Identity
        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            // Indicator dot
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.accent-emerald;
                }
            }

            Text {
                text: "Active Client:";
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                text: root.active_email;
                color: Theme.text-primary;
                font-size: Theme.font-sm;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                text: "• " + root.client_status;
                color: Theme.accent-emerald;
                font-size: Theme.font-xs;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        // Relaunch Button
        Rectangle {
            width: 80px;
            height: 22px;
            border-radius: Theme.radius-sm;
            background: relaunch_touch.has-hover ? #064e3b : Theme.bg-button;
            border-width: 1px;
            border-color: relaunch_touch.has-hover ? Theme.accent-emerald : Theme.border-default;

            animate background { duration: 150ms; }
            animate border-color { duration: 150ms; }

            HorizontalLayout {
                alignment: center;

                Text {
                    text: "RESTART LS";
                    color: relaunch_touch.has-hover ? Theme.text-primary : Theme.accent-emerald;
                    font-size: Theme.font-xs;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            relaunch_touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.relaunch_clicked();
                }
            }
        }
    }
}

// Claude Card: High-density horizontal row card with purple branding, session & weekly quotas, token usage
export component ClaudeCard inherits Rectangle {
    in property <string> email: "claude.user@work.io";
    in property <string> tier: "Claude Pro / Max";
    in property <float> session_pct: 74.0;
    in property <string> session_label: "74%";
    in property <float> weekly_pct: 52.0;
    in property <string> weekly_label: "52%";
    in property <string> reset_countdown: "1h 45m";
    in property <string> token_usage_text: "185k tokens ($2.10)";
    in property <bool> is_connected: true;

    callback action_clicked();

    background: Theme.bg-card;
    border-width: 1px;
    border-color: Theme.border-default;
    border-radius: Theme.radius-md;
    clip: true;

    // Left purple accent
    Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: parent.height;
        background: #a855f7;
    }

    VerticalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 5px;

        // Top line: Identity & Sync Button
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 7px;

                Rectangle {
                    background: #2e1065;
                    border-width: 1px;
                    border-color: #a855f7;
                    border-radius: Theme.radius-xs;

                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        padding-top: 1px;
                        padding-bottom: 1px;
                        alignment: center;

                        Text {
                            text: "CLAUDE";
                            color: Theme.accent-purple;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: root.tier;
                    color: Theme.text-primary;
                    font-size: Theme.font-sm;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.email;
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.token_usage_text != "" : Rectangle {
                    background: Theme.bg-badge;
                    border-width: 1px;
                    border-color: Theme.border-default;
                    border-radius: Theme.radius-xs;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 1px;
                        padding-bottom: 1px;
                        alignment: center;

                        Text {
                            text: root.token_usage_text;
                            color: Theme.accent-purple;
                            font-size: Theme.font-xs;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Sync Button
            Rectangle {
                width: 80px;
                height: 22px;
                border-radius: Theme.radius-sm;
                background: claude_btn_touch.has-hover ? #3b0764 : Theme.bg-button;
                border-width: 1px;
                border-color: claude_btn_touch.has-hover ? Theme.accent-purple : Theme.border-default;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                HorizontalLayout {
                    alignment: center;

                    Text {
                        text: "SYNC";
                        color: claude_btn_touch.has-hover ? Theme.text-primary : Theme.accent-purple;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                claude_btn_touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.action_clicked();
                    }
                }
            }
        }

        // Bottom line: Dual meters side-by-side
        HorizontalLayout {
            spacing: Theme.spacing-md;

            // Meter 1: 5-Hour Session Quota
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "5h Limit";
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        font-weight: 500;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;

                        Text {
                            text: (root.reset_countdown == "Ready" || root.reset_countdown == "Full Quota") ? "Ready" : "Reset: " + root.reset_countdown;
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            overflow: elide;
                        }

                        Text {
                            text: root.session_label;
                            color: Theme.text-primary;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                        }
                    }
                }

                ProgressBar {
                    progress: root.session_pct;
                    custom-color-enabled: true;
                    custom-fill-color: Theme.accent-purple;
                }
            }

            // Meter 2: Weekly Quota
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Weekly Cap";
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        font-weight: 500;
                    }

                    Text {
                        text: root.weekly_label;
                        color: Theme.text-primary;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                    }
                }

                ProgressBar {
                    progress: root.weekly_pct;
                    custom-color-enabled: true;
                    custom-fill-color: Theme.accent-purple;
                }
            }
        }
    }
}

// DeepSeek Card: Single compact horizontal bar with blue branding and balance display
export component DeepSeekCard inherits Rectangle {
    in property <string> balance_text: "$10.50 USD";
    in property <string> status_text: "Online / Ready";
    in property <string> tier_text: "Pay-as-you-go";
    in property <string> monthly_usage_text: "Month: $3.40";
    in property <bool> is_connected: true;

    callback top_up_clicked();

    background: Theme.bg-card;
    border-width: 1px;
    border-color: Theme.border-default;
    border-radius: Theme.radius-md;
    clip: true;

    // Left blue accent
    Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: parent.height;
        background: #3b82f6;
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        padding-top: 8px;
        padding-bottom: 8px;
        alignment: space-between;

        // Identity
        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                background: #172554;
                border-width: 1px;
                border-color: #3b82f6;
                border-radius: Theme.radius-xs;

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    padding-top: 1px;
                    padding-bottom: 1px;
                    alignment: center;

                    Text {
                        text: "DEEPSEEK";
                        color: Theme.accent-blue;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: root.tier_text;
                color: Theme.text-primary;
                font-size: Theme.font-sm;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                text: "• " + root.status_text;
                color: Theme.accent-emerald;
                font-size: Theme.font-xs;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        // Metrics & Manage Action
        HorizontalLayout {
            spacing: Theme.spacing-md;

            HorizontalLayout {
                spacing: 6px;

                Text {
                    text: "Balance:";
                    color: Theme.text-secondary;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }

                Text {
                    text: root.balance_text;
                    color: Theme.accent-emerald;
                    font-size: Theme.font-sm;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: "(" + root.monthly_usage_text + ")";
                    color: Theme.accent-blue;
                    font-size: Theme.font-xs;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 80px;
                height: 22px;
                border-radius: Theme.radius-sm;
                background: ds_btn_touch.has-hover ? #1e3a8a : Theme.bg-button;
                border-width: 1px;
                border-color: ds_btn_touch.has-hover ? Theme.accent-blue : Theme.border-default;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                HorizontalLayout {
                    alignment: center;

                    Text {
                        text: "MANAGE";
                        color: ds_btn_touch.has-hover ? Theme.text-primary : Theme.accent-blue;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                ds_btn_touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.top_up_clicked();
                    }
                }
            }
        }
    }
}
